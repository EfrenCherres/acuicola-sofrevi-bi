            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Hallazgos clave",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#d99a2b"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "1. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#c9d3e3"
                    }
                  },
                  {
                    "value": "El precio, no el costo, explica la caída del margen.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#ffffff"
                    }
                  },
                  {
                    "value": " ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "color": "#d99a2b"
                    }
                  },
                  {
                    "value": "De 2022 a 2025 el precio bajó de",
                    "textStyle": {
                      "color": "#c9d3e3"
                    }
                  },
                  {
                    "value": " $2,88 a $2,13/lb",
                    "textStyle": {
                      "color": "#d99a2b"
                    }
                  },
                  {
                    "value": ", mientras el costo pasó de",
                    "textStyle": {
                      "color": "#c9d3e3"
                    }
                  },
                  {
                    "value": " $1,59 a $1,68",
                    "textStyle": {
                      "color": "#d99a2b"
                    }
                  },
                  {
                    "value": ".",
                    "textStyle": {
                      "color": "#c9d3e3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. El alimento barato salió caro.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#ffffff"
                    }
                  },
                  {
                    "value": " ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#d99a2b"
                    }
                  },
                  {
                    "value": "Aquafeed cuesta 17 % menos por kg, pero convierte peor",
                    "textStyle": {
                      "color": "#c9d3e3"
                    }
                  },
                  {
                    "value": " (FCA 1,60 vs 1,30) ",
                    "textStyle": {
                      "color": "#d99a2b"
                    }
                  },
                  {
                    "value": "y da camarón más pequeño. Impacto estimado: $679,7 mil, 90 % en ventas perdidas.",
                    "textStyle": {
                      "color": "#c9d3e3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#ffffff"
                    }
                  },
                  {
                    "value": "Desde 2024, la mezcla de tallas también baja el precio. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt"
                    }
                  },
                  {
                    "value": "En 2025–2026 explica cerca del 40 % de la caída frente a 2022 "
                  },
                  {
                    "value": "(≈ ",
                    "textStyle": {
                      "color": "#d99a2b"
                    }
                  },
                  {
                    "value": "−$2,48 M",
                    "textStyle": {
                      "fontWeight": "bold",
                      "color": "#d99a2b"
                    }
                  },
                  {
                    "value": ")"
                  },
                  {
                    "value": ".",
                    "textStyle": {
                      "fontWeight": "bold",
                      "color": "#c9d3e3"
                    }
                  }
                ]
              }
            ]
