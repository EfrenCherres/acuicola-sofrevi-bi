DEFINE
    MEASURE 'Medidas DAX'[Gastos Operativos USD] =
        SUM ( fact_Gastos[Monto_USD] )
    MEASURE 'Medidas DAX'[Costo Larvas USD] =
        CALCULATE (
            SUMX ( fact_Ciclos, fact_Ciclos[Larvas_Sembradas_miles] * fact_Ciclos[Costo_Larva_USD_mil] ),
            USERELATIONSHIP ( Dim_Calendario[Date], fact_Ciclos[Fecha_Siembra] )
        )
    MEASURE 'Medidas DAX'[Costo Total USD] =
        [Gastos Operativos USD] + [Compras Alimento USD] + [Costo Larvas USD]
    MEASURE 'Medidas DAX'[Ventas (meses cerrados)] =
        CALCULATE ( [Ventas USD],
            KEEPFILTERS ( FILTER ( VALUES ( Dim_Calendario[Inicio Mes] ), CALCULATE ( NOT ISEMPTY ( fact_Gastos ) ) ) ) )
    MEASURE 'Medidas DAX'[Costo Total (meses cerrados)] =
        CALCULATE ( [Costo Total USD],
            KEEPFILTERS ( FILTER ( VALUES ( Dim_Calendario[Inicio Mes] ), CALCULATE ( NOT ISEMPTY ( fact_Gastos ) ) ) ) )
    MEASURE 'Medidas DAX'[Libras (meses cerrados)] =
        CALCULATE ( [Libras Vendidas],
            KEEPFILTERS ( FILTER ( VALUES ( Dim_Calendario[Inicio Mes] ), CALCULATE ( NOT ISEMPTY ( fact_Gastos ) ) ) ) )
    MEASURE 'Medidas DAX'[Margen USD] =
        [Ventas (meses cerrados)] - [Costo Total (meses cerrados)]
    MEASURE 'Medidas DAX'[Margen %] =
        DIVIDE ( [Margen USD], [Ventas (meses cerrados)] )
    MEASURE 'Medidas DAX'[Costo por Libra (USD)] =
        DIVIDE ( [Costo Total (meses cerrados)], [Libras (meses cerrados)] )

EVALUATE
SUMMARIZECOLUMNS (
    ROLLUPADDISSUBTOTAL ( Dim_Calendario[Año], "Es total" ),
    "Gastos", [Gastos Operativos USD],
    "Alimento", [Compras Alimento USD],
    "Larvas", [Costo Larvas USD],
    "Costo total", [Costo Total (meses cerrados)],
    "Ventas", [Ventas (meses cerrados)],
    "Margen", [Margen USD],
    "Margen %", [Margen %],
    "Costo/lb", [Costo por Libra (USD)],
    "Precio/lb", [Precio Promedio (USD/lb)]
)
ORDER BY [Es total], Dim_Calendario[Año]