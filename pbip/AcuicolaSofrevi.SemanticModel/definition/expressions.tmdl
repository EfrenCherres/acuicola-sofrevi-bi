expression QA_SUP07_Detalle =
		let
		    K = Table.Group(fact_Kardex, {"ID_Ciclo"}, {
		        {"Desp", each List.Sum([Kg_Despachados]), type number},
		        {"Supervisor", each List.Mode([Entregado_A]), type text}}),
		    A = Table.Group(fact_Alimentacion, {"ID_Ciclo"}, {{"Apl", each List.Sum(List.RemoveNulls([Kg_Aplicados])), type number}}),
		    J = Table.ExpandTableColumn(Table.NestedJoin(K, {"ID_Ciclo"}, A, {"ID_Ciclo"}, "A", JoinKind.Inner), "A", {"Apl"}),
		    C = Table.ExpandTableColumn(Table.NestedJoin(J, {"ID_Ciclo"}, fact_Ciclos, {"ID_Ciclo"}, "C", JoinKind.Inner), "C", {"Piscina", "Fecha_Siembra"}),
		    Grupo = Table.AddColumn(C, "Grupo", each if [Supervisor] = "SUP-07" then "SUP-07" else "Resto", type text),
		    Anio = Table.AddColumn(Grupo, "Anio", each Date.Year([Fecha_Siembra]), Int64.Type),
		    PorAnio = Table.Group(Anio, {"Grupo", "Anio"}, {
		        {"Ciclos", each Table.RowCount(_), Int64.Type},
		        {"Kg_Diferencia", each List.Sum([Desp]) - List.Sum([Apl]), type number},
		        {"Pct_Diferencia", each Number.Round((List.Sum([Desp]) - List.Sum([Apl])) / List.Sum([Desp]) * 100, 2), type number},
		        {"Piscinas", each Text.Combine(List.Sort(List.Distinct([Piscina])), ", "), type text}}),
		    Orden = Table.Sort(PorAnio, {{"Grupo", Order.Ascending}, {"Anio", Order.Ascending}})
		in
		    Orden
	lineageTag: 201d8aa6-7457-4560-a1ea-4dfcd3b42496
