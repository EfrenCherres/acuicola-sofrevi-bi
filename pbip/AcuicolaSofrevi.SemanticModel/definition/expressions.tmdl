expression QA_Controles_Kardex =
		let
		    s = src_Kardex,
		    F = List.Transform(s[Fecha], each try fnTextoAFecha(_) otherwise "ERR"),
		    H = List.Transform(s[Hora], each try Time.From(_) otherwise "ERR"),
		    Sx = List.Transform(s[Sacos], each try fnTextoANumero(_) otherwise "ERR"),
		    Fd = List.Select(F, each _ is date),
		    Sn = List.Select(Sx, each _ is number),
		    Resultado = #table({"Control", "Valor"}, {
		        {"Filas", Table.RowCount(s)},
		        {"Fechas que no convierten", List.Count(List.Select(F, each _ = "ERR"))},
		        {"Fecha mínima", List.Min(Fd)},
		        {"Fecha máxima", List.Max(Fd)},
		        {"Horas que no convierten", List.Count(List.Select(H, each _ = "ERR"))},
		        {"Sacos que no convierten", List.Count(List.Select(Sx, each _ = "ERR"))},
		        {"Sacos vacíos", List.Count(List.Select(Sx, each _ = null))},
		        {"Sacos en cero o negativos", List.Count(List.Select(Sn, each _ <= 0))},
		        {"Sacos con decimales", List.Count(List.Select(Sn, each _ <> Number.Round(_)))},
		        {"Sacos máximo", List.Max(Sn)},
		        {"Filas duplicadas exactas", Table.RowCount(s) - Table.RowCount(Table.Distinct(s))},
		        {"N_Documento repetidos", Table.RowCount(s) - List.Count(List.Distinct(s[N_Documento]))},
		        {"Repetidas por Fecha + Piscina + Hora", Table.RowCount(s) - Table.RowCount(Table.Distinct(s, {"Fecha", "Piscina", "Hora"}))}})
		in
