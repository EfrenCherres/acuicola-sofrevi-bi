expression QA_Controles_Agua =
		let
		    s = src_ParametrosAgua,
		    Rangos = {
		        {"OD_Madrugada_mgL", 0.5, 15},
		        {"OD_Tarde_mgL", 0.5, 20},
		        {"Temperatura_C", 18, 38},
		        {"Salinidad_ppt", 0, 50},
		        {"pH", 6, 10},
		        {"Transparencia_cm", 5, 150}},
		    Revisar = (r) =>
		        let
		            col = r{0}, lo = r{1}, hi = r{2},
		            V = List.Transform(Table.Column(s, col), each try fnTextoANumero(_) otherwise "ERR"),
		            N = List.Select(V, each _ is number)
		        in
		            {col,
		             List.Count(List.Select(V, each _ = "ERR")),
		             List.Count(List.Select(V, each _ = null)),
		             List.Count(List.Select(N, each _ = 0)),
		             List.Count(List.Select(N, each _ < lo or _ > hi)),
		             List.Min(N), List.Max(N), Number.Round(List.Median(N), 2)},
		    Resultado = #table(
		        {"Parametro", "No_convierten", "Vacios", "Ceros", "Fuera_de_rango", "Minimo", "Maximo", "Mediana"},
		        List.Transform(Rangos, Revisar)),
		  Personalizado = Resultado
		in
		    Personalizado
	lineageTag: fc1cb6e3-9d15-4fbd-b389-464111e1a4b9
	queryGroup: QA

	annotation PBI_ResultType = Table

expression QA_Agua_Raros =
		let
		    s = src_ParametrosAgua,
		    N = (v) => try fnTextoANumero(v) otherwise null,
		    M = Table.AddColumn(s, "Marcas", each
		        (if [OD_Madrugada_mgL] = null then "OD vacío · " else if N([OD_Madrugada_mgL]) > 15 then "OD imposible · " else "") &
		        (if [Temperatura_C] = null then "Temp vacía · " else if N([Temperatura_C]) = 0 then "Temp = 0 · " else "") &
		        (if [pH] = null then "pH vacío" else if N([pH]) > 10 then "pH imposible" else ""), type text),
		    Raras = Table.SelectRows(M, each [Marcas] <> ""),
		    G = Table.Group(Raras, {"Marcas", "Tecnico"}, {
		        {"Filas", each Table.RowCount(_), Int64.Type},
		        {"Valores_OD", each Text.Combine(List.Transform(List.FirstN(List.Distinct([OD_Madrugada_mgL]), 5), Text.From), " | "), type text},
		        {"Valores_pH", each Text.Combine(List.Transform(List.FirstN(List.Distinct([pH]), 5), Text.From), " | "), type text}}),
		    Orden = Table.Sort(G, {{"Filas", Order.Descending}})
		in
		    Orden
	lineageTag: 63937873-4e55-467e-afca-b749fbc86220
	queryGroup: QA

	annotation PBI_ResultType = Table

expression QA_Ceros_vs_Oxigeno =
		let
		    M = Table.SelectRows(stg_ParametrosAgua, each [OD_Madrugada_mgL] <> null),
		    Exp = Table.ExpandListColumn(Table.AddColumn(M, "Dia", each {Date.AddDays([Fecha], -1), [Fecha], Date.AddDays([Fecha], 1)}), "Dia"),
		    ODdia = Table.Group(Exp, {"Piscina", "Dia"}, {{"OD_min", each List.Min([OD_Madrugada_mgL]), type number}}),
		    R = Table.SelectRows(Table.SelectColumns(fact_Alimentacion, {"Piscina", "Fecha", "Kg_Aplicados"}), each [Kg_Aplicados] <> null),
		    J = Table.ExpandTableColumn(Table.NestedJoin(R, {"Piscina", "Fecha"}, ODdia, {"Piscina", "Dia"}, "O", JoinKind.LeftOuter), "O", {"OD_min"}),
		    T = Table.AddColumn(J, "Racion", each if [Kg_Aplicados] = 0 then "Ración en 0 kg" else "Ración normal", type text),
		    C = Table.AddColumn(T, "Oxigeno", each if [OD_min] = null then "Sin medición cercana" else if [OD_min] < 3 then "OD bajo (< 3)" else "OD normal", type text),
		    G = Table.Group(C, {"Racion", "Oxigeno"}, {{"Raciones", each Table.RowCount(_), Int64.Type}}),
		    Pct = Table.AddColumn(G, "Pct_dentro_del_tipo", each Number.Round([Raciones] / List.Sum(Table.SelectRows(G, (r) => r[Racion] = [Racion])[Raciones]) * 100, 1), type number),
		    Orden = Table.Sort(Pct, {{"Racion", Order.Ascending}, {"Oxigeno", Order.Ascending}})
		in
		    Orden
	lineageTag: dd0c5089-f41a-4d32-b0e9-dc811e23ba6e
	queryGroup: QA

	annotation PBI_ResultType = Table

expression QA_Controles_Gastos =
		let
		    T = Table.AddColumn(src_Gastos, "Monto_Num", each try Number.From([Monto_USD], "en-US") otherwise null),
		    Filas = Table.RowCount(T),
		    Montos = List.RemoveNulls(T[Monto_Num]),
		    Resultado = #table({"Control", "Valor"}, {
		        {"Filas", Filas},
		        {"Monto que no convierte a número", Filas - List.Count(Montos)},
		        {"Monto negativo", List.Count(List.Select(Montos, each _ < 0))},
		        {"Monto en 0", List.Count(List.Select(Montos, each _ = 0))},
		        {"Monto mínimo", List.Min(Montos)},
		        {"Monto máximo", List.Max(Montos)},
		        {"Duplicados exactos", Filas - Table.RowCount(Table.Distinct(src_Gastos))},
		        {"Duplicados de clave (Periodo + Centro + Rubro)",
		            Filas - Table.RowCount(Table.Distinct(src_Gastos, {"Periodo", "Centro_Costo", "Rubro"}))}
		    })
		in
		    Resultado
	lineageTag: 1324d706-ff15-4091-8f82-28ca35bf9f16
