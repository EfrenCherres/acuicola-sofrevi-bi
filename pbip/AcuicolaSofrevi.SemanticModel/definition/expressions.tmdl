expression QA_Controles_Alimentacion =
		let
		    s = src_Alimentacion,
		    F = List.Transform(s[Fecha], each try fnTextoAFecha(_) otherwise "ERR"),
		    K = List.Transform(s[Kg_Aplicados], each try fnTextoANumero(_) otherwise "ERR"),
		    Fd = List.Select(F, each _ is date),
		    Kn = List.Select(K, each _ is number),
		    Resultado = #table({"Control", "Valor"}, {
		        {"Filas", Table.RowCount(s)},
		        {"Fechas que no convierten", List.Count(List.Select(F, each _ = "ERR"))},
		        {"Fechas vacías", List.Count(List.Select(F, each _ = null))},
		        {"Fecha mínima", List.Min(Fd)},
		        {"Fecha máxima", List.Max(Fd)},
		        {"Kg que no convierten", List.Count(List.Select(K, each _ = "ERR"))},
		        {"Kg vacíos", List.Count(List.Select(K, each _ = null))},
		        {"Kg en cero", List.Count(List.Select(Kn, each _ = 0))},
		        {"Kg negativos", List.Count(List.Select(Kn, each _ < 0))},
		        {"Kg mínimo mayor que cero", List.Min(List.Select(Kn, each _ > 0))},
		        {"Kg máximo", List.Max(Kn)},
		        {"Turnos distintos", Text.Combine(List.Transform(List.Distinct(s[Turno]), each Text.From(_)), " | ")},
		        {"Registrado_Por distintos", Text.Combine(List.Transform(List.Distinct(s[Registrado_Por]), each Text.From(_)), " | ")}})
		in
		    Resultado
