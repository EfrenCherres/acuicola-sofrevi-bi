expression QA_Impacto_Kg =
		let
		    s = src_Alimentacion,
		    K = List.Transform(s[Kg_Aplicados], each try fnTextoANumero(_) otherwise null),
		    Kn = List.Select(K, each _ is number),
		    Bruto = List.Sum(Kn),
		    Neg = List.Sum(List.Select(Kn, each _ < 0)),
		    Limpio = List.Sum(List.RemoveNulls(stg_Alimentacion[Kg_Aplicados])),
		    Dup = (Bruto - 2 * Neg) - Limpio,
		     PrecioKg = List.Sum(fact_Compras[Subtotal_USD]) / List.Sum(fact_Compras[Kg_Comprados]),
		    Resultado = #table({"Control", "Valor"}, {
		        {"Kg total sin limpiar (como venía)", Number.Round(Bruto, 1)},
		        {"Kg negativos (restaban)", Number.Round(Neg, 1)},
		        {"Kg duplicados (sumaban)", Number.Round(Dup, 1)},
		        {"Kg total limpio", Number.Round(Limpio, 1)},
		        {"Diferencia limpio − sin limpiar", Number.Round(Limpio - Bruto, 1)},
		        {"Precio promedio USD/kg (compras)", Number.Round(PrecioKg, 3)},
		        {"USD negativos", Number.Round(-Neg * PrecioKg, 0)},
		        {"USD duplicados", Number.Round(Dup * PrecioKg, 0)}})
		in
		    Resultado
	lineageTag: 9a8e95c0-fcca-468a-b865-1bb0007150cf
	queryGroup: QA

