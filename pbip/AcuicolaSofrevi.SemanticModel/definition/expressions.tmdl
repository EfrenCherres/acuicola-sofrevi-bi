		        {"dim_Proveedor", dim_Proveedor}, {"dim_Empacadora", dim_Empacadora}, {"fact_Ciclos", fact_Ciclos},
		        {"fact_Compras", fact_Compras}, {"fact_Liquidaciones", fact_Liquidaciones}, {"fact_Alimentacion", fact_Alimentacion},
		        {"fact_Kardex", fact_Kardex}, {"fact_ParametrosAgua", fact_ParametrosAgua}, {"fact_Gastos", fact_Gastos}
		    }),
		    #"Filas y columnas" = Table.AddColumn(Table.AddColumn(Tablas,
		        "Filas", each Table.RowCount([Datos]), Int64.Type),
		        "Columnas", each Text.Combine(Table.ColumnNames([Datos]), ", "), type text),
