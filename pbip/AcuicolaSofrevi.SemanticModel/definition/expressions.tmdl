expression QA_Kardex_vs_Alimentacion =
		let
		    K = Table.Group(fact_Kardex, {"Piscina", "Fecha"}, {{"Desp", each List.Sum([Kg_Despachados]), type number}}),
		    A = Table.Group(fact_Alimentacion, {"Piscina", "Fecha"}, {{"Apl", each List.Sum(List.RemoveNulls([Kg_Aplicados])), type number}}),
		    J = Table.NestedJoin(K, {"Piscina", "Fecha"}, A, {"Piscina", "Fecha"}, "A", JoinKind.FullOuter),
		    E = Table.ExpandTableColumn(J, "A", {"Apl"}, {"Apl"}),
		    D = Table.AddColumn(E, "Dif", each (if [Desp] = null then 0 else [Desp]) - (if [Apl] = null then 0 else [Apl]), type number),
		    S = Table.AddColumn(D, "Situacion", each
		        if [Desp] = null then "Ración sin despacho de bodega"
		        else if [Apl] = null then "Despacho sin ración registrada"
		        else if [Dif] < -1 then "Se aplicó MÁS de lo despachado"
		        else if [Dif] <= 25 then "Cuadra (diferencia menor a 1 saco)"
		        else "Se despachó MÁS de lo aplicado (más de 1 saco)", type text),
		    G = Table.Group(S, {"Situacion"}, {
		        {"Dias_Piscina", each Table.RowCount(_), Int64.Type},
		        {"Kg_Despachados", each List.Sum(List.RemoveNulls([Desp])), type number},
		        {"Kg_Aplicados", each List.Sum(List.RemoveNulls([Apl])), type number},
		        {"Kg_Diferencia", each List.Sum([Dif]), type number}})
		in
		    G
	lineageTag: 556025b3-c78e-4b8d-ad1e-5f3c139d5bd1
	queryGroup: QA

	annotation PBI_ResultType = Table

expression QA_Kardex_vs_Alim_Ciclo =
		let
		    K = Table.Group(fact_Kardex, {"ID_Ciclo"}, {
		        {"Desp", each List.Sum([Kg_Despachados]), type number},
		        {"Supervisor", each List.Mode([Entregado_A]), type text}}),
		    A = Table.Group(fact_Alimentacion, {"ID_Ciclo"}, {
		        {"Apl", each List.Sum(List.RemoveNulls([Kg_Aplicados])), type number},
		        {"Sin_dato", each List.Count(List.Select([Kg_Aplicados], each _ = null)), Int64.Type}}),
		    J = Table.ExpandTableColumn(Table.NestedJoin(K, {"ID_Ciclo"}, A, {"ID_Ciclo"}, "A", JoinKind.Inner), "A", {"Apl", "Sin_dato"}),
		    D = Table.AddColumn(J, "Dif", each [Desp] - [Apl], type number),
		    PorSupervisor = Table.Group(D, {"Supervisor"}, {
		        {"Ciclos", each Table.RowCount(_), Int64.Type},
		        {"Kg_Despachados", each List.Sum([Desp]), type number},
		        {"Kg_Aplicados", each List.Sum([Apl]), type number},
		        {"Kg_Diferencia", each List.Sum([Dif]), type number},
		        {"Raciones_sin_dato", each List.Sum([Sin_dato]), Int64.Type}}),
		    Pct = Table.AddColumn(PorSupervisor, "Pct_Diferencia", each Number.Round([Kg_Diferencia] / [Kg_Despachados] * 100, 2), type number),
		    Orden = Table.Sort(Pct, {{"Pct_Diferencia", Order.Descending}})
		in
		    Orden
	lineageTag: be74a8a2-6729-4742-b2e4-db1aff97dea1
	queryGroup: QA

