		let
		    L = Table.Distinct(Table.SelectColumns(stg_Liquidaciones, {"N_Liquidacion", "Piscina", "Fecha_Cosecha", "Lbs_Guia_Remision"})),
		    C = Table.SelectColumns(fact_Ciclos, {"ID_Ciclo", "Piscina", "Fecha_Cosecha", "Biomasa_lb"}),
		    J = Table.NestedJoin(L, {"Fecha_Cosecha"}, C, {"Fecha_Cosecha"}, "Ciclos", JoinKind.LeftOuter),
		    Mejor = Table.AddColumn(J, "Candidato", (fila) =>
		        let t = fila[Ciclos] in
		        if Table.IsEmpty(t) then null
		        else Table.First(Table.Sort(Table.AddColumn(t, "Dif", (r) => Number.Abs(r[Biomasa_lb] - fila[Lbs_Guia_Remision])), {{"Dif", Order.Ascending}}))),
		    Est = Table.AddColumn(Mejor, "Piscina_estimada", each if [Candidato] = null then null else [Candidato][Piscina], type text),
		    Dif = Table.AddColumn(Est, "Dif_lb", each if [Candidato] = null then null else Number.Round([Candidato][Dif], 0), type number),
		    Ciclos_dia = Table.AddColumn(Dif, "Ciclos_esa_fecha", each Table.RowCount([Ciclos]), Int64.Type),
		    Acierta = Table.AddColumn(Ciclos_dia, "Acierta", each if [Piscina] = null then null else [Piscina] = [Piscina_estimada], type logical),
		    Salida = Table.RemoveColumns(Acierta, {"Ciclos", "Candidato"})
		in
		    Salida
	lineageTag: be4fd14a-a05f-4ab4-83f6-017b56087d63
	queryGroup: QA

