expression stg_Alimentacion =
		let
		  Origen = src_Alimentacion,
		  #"Fecha: número de serie → fecha" = Table.TransformColumns(Origen, {{"Fecha", fnTextoAFecha, type date}}),
		  #"Piscina: dígitos → P-00" = Table.TransformColumns(#"Fecha: número de serie → fecha", {{"Piscina", each "P-" & Text.PadStart(Text.Select(_, {"0".."9"}), 2, "0"), type text}}),
		  #"Proveedor: palabra clave → razón social" = Table.TransformColumns(#"Piscina: dígitos → P-00", {{"Proveedor", each
		    let t = Text.Remove(Text.Upper(Text.From(_)), {" ", "."}) in
		    if Text.Contains(t, "FEED") then "AQUAFEED LITORAL S.A."
		    else if Text.Contains(t, "ANDINOS") then "BALANCEADOS ANDINOS CIA. LTDA."
		    else if Text.Contains(t, "NUTRIACUA") then "NUTRIACUA S.A."
		    else _, type text}}),
		  #"Kg: S/D → vacío y texto → número" = Table.TransformColumns(#"Proveedor: palabra clave → razón social", {{"Kg_Aplicados", each
		    if _ = null or Text.Upper(Text.Trim(Text.From(_))) = "S/D" then null else fnTextoANumero(_), type nullable number}}),
		  #"Kg: negativos → sin signo (error de signo)" = Table.TransformColumns(#"Kg: S/D → vacío y texto → número", {{"Kg_Aplicados", each if _ = null then null else Number.Abs(_), type nullable number}}),
		  #"Turno: mayúsculas" = Table.TransformColumns(#"Kg: negativos → sin signo (error de signo)", {{"Turno", each Text.Upper(Text.Trim(_)), type text}}),
		  #"Tipos: Registrado_Por como texto" = Table.TransformColumnTypes(#"Turno: mayúsculas", {{"Registrado_Por", type text}}),
		  #"Filas duplicadas exactas: quitar (343)" = Table.Distinct(#"Tipos: Registrado_Por como texto")
		in
		  #"Filas duplicadas exactas: quitar (343)"
