expression fnTextoANumero =
		(v as any) as nullable number =>
		    if v = null then null
		    else if v is number then v
		    else Number.From(Text.Replace(Text.Remove(Text.Trim(Text.From(v)), {"$", " "}), ",", "."), "en-US")
