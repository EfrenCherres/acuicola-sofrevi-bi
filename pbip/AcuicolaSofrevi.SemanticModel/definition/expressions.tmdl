expression stg_Compras =
		let
		  Origen = src_Compras,
		  #"Tipos: fecha, texto y números" = Table.TransformColumnTypes(Origen, {{"Fecha_Factura", type date}, {"N_Factura", type text}, {"Producto", type text}, {"Presentacion", type text}, {"Precio_Saco_USD", type number}, {"Subtotal_USD", type number}, {"IVA_USD", type number}, {"Total_USD", type number}, {"Cantidad_Sacos", type number}}),
		  #"Proveedor: 13 formas a 3 (sin espacios ni puntos + palabra clave)" = Table.TransformColumns(#"Tipos: fecha, texto y números", {{"Proveedor", each
		    let t = if _ = null then "" else Text.Remove(Text.Upper(Text.From(_)), {" ", "."}) in
		    if t = "" then "Desconocido"
		    else if Text.Contains(t, "FEED") then "AQUAFEED LITORAL S.A."
		    else if Text.Contains(t, "ANDINOS") then "BALANCEADOS ANDINOS CIA. LTDA."
		    else if Text.Contains(t, "NUTRIACUA") then "NUTRIACUA S.A."
		    else _, type text}}),
		  #"Filas duplicadas exactas: quitar (4 facturas cargadas dos veces)" = Table.Distinct(#"Proveedor: 13 formas a 3 (sin espacios ni puntos + palabra clave)")
		in
		  #"Filas duplicadas exactas: quitar (4 facturas cargadas dos veces)"
	lineageTag: 9b5ed758-10b7-465e-932a-41c803d0611f
	queryGroup: 02_Staging

