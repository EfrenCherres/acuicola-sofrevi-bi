expression QA_Biomasa_Unidad =
		let
		    s = stg_Ciclos,
		    ConDatos = Table.SelectRows(s, each [Biomasa_lb] <> null and [Sobrevivencia_pct] <> null and [Peso_Muestreo_g] <> null),
		    Sistema = Table.AddColumn(ConDatos, "Sistema", each Text.BeforeDelimiter([ID_Ciclo], "-"), type text),
		    Esperada = Table.AddColumn(Sistema, "Bio_esperada_kg", each [Larvas_Sembradas_miles] * [Sobrevivencia_pct] / 100 * [Peso_Muestreo_g], type number),
		    Razon = Table.AddColumn(Esperada, "Razon", each [Biomasa_lb] / [Bio_esperada_kg], type number),
		    Resumen = Table.Group(Razon, {"Sistema"}, {
		        {"Ciclos", each Table.RowCount(_), Int64.Type},
		        {"Razon_prom", each Number.Round(List.Average([Razon]), 2), type number},
		        {"Razon_min", each Number.Round(List.Min([Razon]), 2), type number},
		        {"Razon_max", each Number.Round(List.Max([Razon]), 2), type number}})
		in
		    Resumen
	lineageTag: f03ea532-ff74-471e-a8eb-5dcd18e7168b
