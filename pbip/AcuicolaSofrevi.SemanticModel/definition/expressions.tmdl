expression QA_Atipicos_Ciclos =
		let
		    s = stg_Ciclos,
		    Cols = {"ID_Ciclo", "Piscina", "Larvas_Sembradas_miles", "Densidad_m2", "Peso_Muestreo_g", "Biomasa_lb", "Sobrevivencia_pct", "Tipo_Cosecha"},
		    L = Table.AddColumn(Table.SelectColumns(Table.SelectRows(s, each [Larvas_Sembradas_miles] > 5000), Cols), "Motivo", each "Larvas > 5000"),
		    P = Table.AddColumn(Table.SelectColumns(Table.SelectRows(s, each [Peso_Muestreo_g] <> null and [Peso_Muestreo_g] > 60), Cols), "Motivo", each "Peso > 60 g"),
		    Juntas = Table.Combine({L, P}),
		    ConArea = Table.ExpandTableColumn(Table.NestedJoin(Juntas, {"Piscina"}, dim_Piscina, {"Piscina"}, "dim", JoinKind.LeftOuter), "dim", {"Area_ha"}),
		    Esperadas = Table.AddColumn(ConArea, "Larvas_esperadas_miles", each Number.Round([Area_ha] * [Densidad_m2] * 10, 1), type number)
		in
		    Esperadas
	lineageTag: 9155b6fc-e415-4c0b-9af5-4304ffec4d81
	queryGroup: QA

	annotation PBI_ResultType = Table

expression QA_Larvas_vs_Area =
		let
		    s = stg_Ciclos,
		    ConArea = Table.ExpandTableColumn(Table.NestedJoin(s, {"Piscina"}, dim_Piscina, {"Piscina"}, "dim", JoinKind.LeftOuter), "dim", {"Area_ha"}),
		    Esperadas = Table.AddColumn(ConArea, "Esperadas", each Number.Round([Area_ha] * [Densidad_m2] * 10, 1), type number),
		    Desvio = Table.AddColumn(Esperadas, "Desvio_pct", each Number.Round(([Larvas_Sembradas_miles] - [Esperadas]) / [Esperadas] * 100, 1), type number),
		    Fuera = Table.SelectRows(Desvio, each Number.Abs([Desvio_pct]) > 5),
		    Resultado = Table.SelectColumns(Fuera, {"ID_Ciclo", "Piscina", "Area_ha", "Densidad_m2", "Larvas_Sembradas_miles", "Esperadas", "Desvio_pct"})
		in
		    Resultado
	lineageTag: f4bf8ea8-ea03-4592-bf17-38cf40d1d7b9
