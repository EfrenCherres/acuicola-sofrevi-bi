expression fnTextoANumero =
		let
		  Origen = (v as any) as nullable number =>
		    if v = null then null
		    else if v is number then v
		    else Number.From(Text.Replace(Text.Trim(Text.From(v)), ",", "."), "en-US")
		in
		  Origen
	lineageTag: 34af6e43-8d61-431f-ae3b-3d2f73ed21ef
	queryGroup: 00_Parametros

