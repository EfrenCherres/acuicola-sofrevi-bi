	annotation PBI_ResultType = Table

expression fnTextoAFecha =
		let
		    Origen = (v as any) as nullable date =>
		let
		    Meses = [ene=1, feb=2, mar=3, abr=4, may=5, jun=6, jul=7, ago=8, sep=9, set=9, oct=10, nov=11, dic=12],
		    Resultado =
		        if v = null then null
		        else if v is number then Date.From(v)
		        else if v is date then v
		        else if v is datetime then Date.From(v)
		        else
		            let
		                t = Text.Lower(Text.Trim(Text.From(v))),
		                p = Text.SplitAny(t, "/-")
		            in
		                if Text.Contains(t, "/") then #date(Number.From(p{2}), Number.From(p{1}), Number.From(p{0}))
		                else if Text.Length(p{0}) = 4 then #date(Number.From(p{0}), Number.From(p{1}), Number.From(p{2}))
		                else #date(2000 + Number.From(p{2}), Record.Field(Meses, p{1}), Number.From(p{0}))
		in
		    Resultado
		in
		    Origen
	lineageTag: 87d75ca7-1aff-4e26-b3f0-74cf87a44e40
	queryGroup: 00_Parametros

