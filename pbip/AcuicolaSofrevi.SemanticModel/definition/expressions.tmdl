expression QA_Numeros_Compras =
		let
		    s = src_Compras,
		  Cols = {"Cantidad_Sacos", "Precio_Saco_USD", "Subtotal_USD", "IVA_USD", "Total_USD"},
		    Fila = (c) =>
		        let
		            v = Table.Column(s, c),
		            t = List.Select(v, each _ is text)
		        in
		            {c,
		             List.Count(List.Select(v, each _ is number)),
		             List.Count(t),
		             List.Count(List.Select(v, each _ = null)),
		             List.Count(List.Select(t, each Text.Contains(_, ",") and Text.Contains(_, "."))),
		             Text.Combine(List.FirstN(List.Distinct(t), 6), "  |  ")},
		    Resultado = #table(
		        {"Columna", "Numeros", "Textos", "Vacios", "Con_punto_y_coma", "Ejemplos_texto"},
		        List.Transform(Cols, Fila))
		in
		    Resultado
	lineageTag: c5aaeb69-620f-493e-a936-858b9c60bf0f
	queryGroup: QA

	annotation PBI_ResultType = Table

expression QA_Calculos_Compras =
		let
		    s = src_Compras,
		    D = Table.AddColumn(s, "Dif_Subtotal", each Number.Round([Subtotal_USD] - [Cantidad_Sacos] * [Precio_Saco_USD], 2), type number),
		    T = Table.AddColumn(D, "Dif_Total", each Number.Round([Total_USD] - [Subtotal_USD] - [IVA_USD], 2), type number),
		    Fila = (nombre, lista) => {nombre,
		        List.Count(List.Select(lista, each Number.Abs(_) > 0.01)),
		        List.Min(lista), List.Max(lista), Number.Round(List.Sum(lista), 2)},
		    Resultado = #table({"Control", "Filas_con_diferencia", "Dif_min", "Dif_max", "Suma_dif"}, {
		        Fila("Subtotal = Cantidad × Precio", T[Dif_Subtotal]),
		        Fila("Total = Subtotal + IVA", T[Dif_Total]),
		        {"Diferencia por saco", List.Count(List.Select(Table.ToRecords(T), each Number.Abs([Dif_Subtotal] / [Cantidad_Sacos]) > 0.005)), List.Min(List.Transform(Table.ToRecords(T), each [Dif_Subtotal] / [Cantidad_Sacos])), List.Max(List.Transform(Table.ToRecords(T), each [Dif_Subtotal] / [Cantidad_Sacos])), null},
		        {"IVA distinto de 0", List.Count(List.Select(T[IVA_USD], each _ <> 0)), List.Min(T[IVA_USD]), List.Max(T[IVA_USD]), List.Sum(T[IVA_USD])}})
		in
		    Resultado
	lineageTag: 5b05ac5b-7b8c-41c4-abda-5ff236b2dea4
	queryGroup: QA

	annotation PBI_ResultType = Table

expression QA_Facturas_Repetidas =
		let
		    s = stg_Compras,
		    Conteo = Table.Group(s, {"N_Factura"}, {{"Veces", each Table.RowCount(_), Int64.Type}}),
		    Repetidas = Table.SelectRows(Conteo, each [Veces] > 1),
		    Filas = Table.SelectRows(s, each List.Contains(Repetidas[N_Factura], [N_Factura])),
		    Ordenado = Table.Sort(Filas, {{"N_Factura", Order.Ascending}, {"Proveedor", Order.Ascending}})
		in
		    Ordenado
