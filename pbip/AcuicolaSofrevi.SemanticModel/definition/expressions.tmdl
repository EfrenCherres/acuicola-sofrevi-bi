expression QA_Kg_Negativos =
		let
		    s = src_Alimentacion,
		    K = Table.AddColumn(s, "Kg", each try fnTextoANumero([Kg_Aplicados]) otherwise null, type nullable number),
		    Neg = Table.SelectRows(K, each [Kg] <> null and [Kg] < 0),
		    Abs = List.Transform(Neg[Kg], Number.Abs),
		    Pos = List.Select(K[Kg], each _ <> null and _ > 0),
		    Resumen = (col) => Text.Combine(Table.TransformRows(Table.Group(Neg, {col}, {{"n", each Table.RowCount(_)}}), each Text.From(Record.Field(_, col)) & ": " & Text.From([n])), " | "),
		    Resultado = #table({"Control", "Valor"}, {
		        {"Negativos", Table.RowCount(Neg)},
		        {"Sin signo: mínimo", List.Min(Abs)},
		        {"Sin signo: máximo", List.Max(Abs)},
		        {"Sin signo: promedio", Number.Round(List.Average(Abs), 1)},
		        {"Positivos: promedio", Number.Round(List.Average(Pos), 1)},
		        {"Positivos: mediana", List.Median(Pos)},
		        {"Negativos por registrador", Resumen("Registrado_Por")},
		        {"Negativos por turno", Resumen("Turno")}})
		in
		    Resultado
	lineageTag: d145c335-d3de-4070-b6eb-0a2035a0d6d5
	queryGroup: QA

	annotation PBI_ResultType = Table

expression QA_Kg_Ceros =
		let
		    s = src_Alimentacion,
		    K = Table.AddColumn(s, "Kg", each try fnTextoANumero([Kg_Aplicados]) otherwise null),
		    Z = Table.SelectRows(K, each [Kg] = 0),
		    P = Table.TransformColumns(Z, {{"Piscina", each "P-" & Text.PadStart(Text.Select(_, {"0".."9"}), 2, "0")}, {"Fecha", fnTextoAFecha}}),
		    C = Table.Buffer(Table.SelectColumns(fact_Ciclos, {"Piscina", "Fecha_Siembra", "Fecha_Cosecha"})),
		    Ubicar = Table.AddColumn(P, "Situacion", each
		        let f = [Fecha], p = [Piscina],
		            c = Table.SelectRows(C, (r) => r[Piscina] = p and r[Fecha_Siembra] <= f and (r[Fecha_Cosecha] = null or f <= r[Fecha_Cosecha]))
		        in
		            if Table.IsEmpty(c) then "Fuera de ciclo (piscina sin camarón)"
		            else if c{0}[Fecha_Cosecha] <> null and Duration.Days(c{0}[Fecha_Cosecha] - f) <= 3 then "Últimos 3 días antes de cosechar"
		            else "Dentro del ciclo"),
		    Agrupado = Table.Group(Ubicar, {"Situacion"}, {{"Filas", each Table.RowCount(_), Int64.Type}})
		in
		    Agrupado
	lineageTag: d7f4ae66-3857-4f6f-9982-e0d3f873b69d
