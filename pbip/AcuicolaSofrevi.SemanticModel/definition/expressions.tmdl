		        {"Filas", Total},
		        {"Filas duplicadas exactas", Total - Table.RowCount(Table.Distinct(s))},
		        {"Repetidas por Fecha + Piscina + Turno", Total - Table.RowCount(Table.Distinct(s, {"Fecha", "Piscina", "Turno"}))},
		        {"Primera alimentación con Aquafeed", List.Min(Aqua[Fecha])},
		        {"Alimentación con Aquafeed antes de feb-2024", Table.RowCount(Table.SelectRows(Aqua, each [Fecha] < #date(2024, 2, 1)))}})
		in
