expression QA_Sistemas =
		let
		    s = stg_Ciclos,
		    Sis = Table.AddColumn(s, "Sistema", each Text.BeforeDelimiter([ID_Ciclo], "-"), type text),
		    Resumen = Table.Group(Sis, {"Sistema"}, {
		        {"Ciclos", each Table.RowCount(_), Int64.Type},
		        {"Sin_sobrevivencia", each List.Count(List.Select([Sobrevivencia_pct], each _ = null)), Int64.Type},
		        {"Siembra_desde", each List.Min([Fecha_Siembra]), type date},
		        {"Siembra_hasta", each List.Max([Fecha_Siembra]), type date}})
		in
		    Resumen
