expression QA_TipoCosecha_Duracion =
		let
		    s = stg_Ciclos,
		    Dias = Table.AddColumn(s, "Dias", each if [Fecha_Cosecha] = null then null else Duration.Days([Fecha_Cosecha] - [Fecha_Siembra]), Int64.Type),
		    Resumen = Table.Group(Dias, {"Tipo_Cosecha"}, {
		        {"Filas", each Table.RowCount(_), Int64.Type},
		        {"Sin_cosecha", each List.Count(List.Select([Fecha_Cosecha], each _ = null)), Int64.Type},
		        {"Dias_prom", each Number.Round(List.Average([Dias]), 0), type number},
		        {"Dias_min", each List.Min([Dias]), Int64.Type},
		        {"Dias_max", each List.Max([Dias]), Int64.Type}})
		in
		    Resumen
	lineageTag: b11286ee-2df1-4397-9f4e-1e08887ccd24
