expression QA_SectorC_Antes_Despues =
		let
		    PiscinasC = {"P-17", "P-18", "P-19", "P-20", "P-21", "P-22", "P-23", "P-24"},
		    K = Table.Group(fact_Kardex, {"ID_Ciclo"}, {
		        {"Desp", each List.Sum([Kg_Despachados]), type number},
		        {"Supervisor", each List.Mode([Entregado_A]), type text}}),
