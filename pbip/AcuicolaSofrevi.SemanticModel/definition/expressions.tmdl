expression QA_Biomasa_C =
		let
		    s = stg_Ciclos,
		    C = Table.SelectRows(s, each Text.StartsWith([ID_Ciclo], "C-") and [Biomasa_Cosechada] <> null and [Peso_Muestreo_g] <> null),
		    Kg = Table.AddColumn(C, "Sobrev_si_kg", each [Biomasa_Cosechada] / ([Larvas_Sembradas_miles] * [Peso_Muestreo_g]) * 100, type number),
		    Lb = Table.AddColumn(Kg, "Sobrev_si_lb", each [Sobrev_si_kg] / 2.20462, type number),
		    Fila = (nombre, lista) => {nombre, List.Count(lista), Number.Round(List.Average(lista), 1), Number.Round(List.Min(lista), 1), Number.Round(List.Max(lista), 1), List.Count(List.Select(lista, each _ > 100))},
		    Resultado = #table({"Supuesto", "Ciclos", "Sobrev_prom", "Sobrev_min", "Sobrev_max", "Mayor_a_100"}, {
		        Fila("Si la biomasa fuera kg", Lb[Sobrev_si_kg]),
		        Fila("Si la biomasa fuera lb", Lb[Sobrev_si_lb])})
		in
		    Resultado
	lineageTag: d8055c1d-0dbe-459f-930c-20676f1ad46e
	queryGroup: QA

