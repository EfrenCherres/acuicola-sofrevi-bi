expression QA_Fechas_Ciclos =
		let
		    Formato = (v) =>
		        if v = null then "vacío"
		        else if v is number then "número serial"
		        else if v is date or v is datetime then "fecha real"
		        else let t = Text.Trim(Text.From(v)) in
		            if Text.Contains(t, "/") then "dd/mm/aaaa"
		            else if Text.Length(t) = 10 and Text.Middle(t, 4, 1) = "-" then "aaaa-mm-dd"
		            else if Text.Contains(t, "-") then "dd-mmm-aa"
		            else "otro: " & t,
		    Siembra = Table.Group(Table.AddColumn(src_Ciclos, "Formato", each Formato([Fecha_Siembra])), {"Formato"}, {{"Filas", each Table.RowCount(_), Int64.Type}}),
		    Cosecha = Table.Group(Table.AddColumn(src_Ciclos, "Formato", each Formato([Fecha_Cosecha])), {"Formato"}, {{"Filas", each Table.RowCount(_), Int64.Type}}),
		    Resultado = Table.Combine({
		        Table.AddColumn(Siembra, "Columna", each "Fecha_Siembra"),
		        Table.AddColumn(Cosecha, "Columna", each "Fecha_Cosecha")})
		in
		    Resultado
	lineageTag: 8b513917-22ab-4747-8a4f-e05fdca200fc
	queryGroup: QA

	annotation PBI_ResultType = Table

expression QA_Fechas_DiaMes =
		let
		    Valores = List.Select(
		        List.Combine({src_Ciclos[Fecha_Siembra], src_Ciclos[Fecha_Cosecha]}),
		        each _ is text and Text.Contains(_, "/")),
		    Partes = List.Transform(Valores, each Text.Split(Text.Trim(_), "/")),
		    PrimeraMayor12 = List.Count(List.Select(Partes, each Number.From(_{0}) > 12)),
		    SegundaMayor12 = List.Count(List.Select(Partes, each Number.From(_{1}) > 12)),
		    Resultado = #table({"Prueba", "Valores"}, {
		        {"Total en formato dd/mm/aaaa", List.Count(Valores)},
		        {"Primera parte > 12 (solo puede ser día)", PrimeraMayor12},
		        {"Segunda parte > 12 (sería mes/día)", SegundaMayor12}})
		in
		    Resultado
	lineageTag: 70300877-aaa6-474d-b640-b428060d4183
	queryGroup: QA

	annotation PBI_ResultType = Table

expression QA_Fechas_Errores =
		let
		    Origen = src_Ciclos,
		    Prueba = Table.AddColumn(Origen, "Resultado", each try fnTextoAFecha([Fecha_Cosecha]) otherwise "ERROR"),
		    Errores = Table.SelectRows(Prueba, each [Resultado] = "ERROR"),
		    Columnas = Table.SelectColumns(Errores, {"ID_Ciclo", "Piscina", "Fecha_Siembra", "Fecha_Cosecha", "Tipo_Cosecha"})
		in
		    Columnas
	lineageTag: a1adf3d8-43b5-4122-af9f-8e114855aa43
	queryGroup: QA

	annotation PBI_ResultType = Table

expression QA_Duracion_Ciclos =
		let
		    Origen = stg_Ciclos,
		    SinError = Table.RemoveRowsWithErrors(Origen, {"Fecha_Cosecha"}),
		    ConCosecha = Table.SelectRows(SinError, each [Fecha_Cosecha] <> null),
		    Dias = Table.AddColumn(ConCosecha, "Dias", each Duration.Days([Fecha_Cosecha] - [Fecha_Siembra]), Int64.Type),
		    PorPiscina = Table.Group(Dias, {"Piscina"}, {
		        {"Ciclos", each Table.RowCount(_), Int64.Type},
		        {"Promedio", each Number.Round(List.Average([Dias]), 0), type number},
		        {"Minimo", each List.Min([Dias]), Int64.Type},
		        {"Maximo", each List.Max([Dias]), Int64.Type}}),
		    Ordenado = Table.Sort(PorPiscina, {{"Piscina", Order.Ascending}})
		in
		    Ordenado
	lineageTag: 11c65be9-df60-4001-b996-29db3d11d1dc
	queryGroup: QA

