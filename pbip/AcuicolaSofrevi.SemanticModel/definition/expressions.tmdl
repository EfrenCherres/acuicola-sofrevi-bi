expression QA_Ciclos_Solapados =
		let
		    C = Table.Buffer(Table.SelectColumns(fact_Ciclos, {"ID_Ciclo", "Piscina", "Fecha_Siembra", "Fecha_Cosecha"})),
		    Pares = Table.NestedJoin(C, {"Piscina"}, C, {"Piscina"}, "Otro", JoinKind.Inner),
		    Exp = Table.ExpandTableColumn(Pares, "Otro", {"ID_Ciclo", "Fecha_Siembra", "Fecha_Cosecha"}, {"ID_2", "Siembra_2", "Cosecha_2"}),
		    Fin = (d) => if d = null then #date(2100, 1, 1) else d,
		    Solapados = Table.SelectRows(Exp, each [ID_Ciclo] < [ID_2] and [Fecha_Siembra] <= Fin([Cosecha_2]) and [Siembra_2] <= Fin([Fecha_Cosecha]))
		in
		    Solapados
