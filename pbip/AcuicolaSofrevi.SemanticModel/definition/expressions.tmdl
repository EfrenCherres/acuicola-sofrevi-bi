		    Origen = src_Ciclos,
		    Agrupado = Table.Group(Origen, {"Tipo_Cosecha"}, {{"Filas", each Table.RowCount(_), Int64.Type}}),
		    Ordenado = Table.Sort(Agrupado, {{"Tipo_Cosecha", Order.Ascending}})
		in
		    Ordenado
	lineageTag: c6f81600-6f8b-481a-b77f-f521a0667c77
