expression QA_Atipicos_Ciclos =
		let
		    s = stg_Ciclos,
		    Cols = {"ID_Ciclo", "Piscina", "Larvas_Sembradas_miles", "Densidad_m2", "Peso_Muestreo_g", "Biomasa_lb", "Sobrevivencia_pct", "Tipo_Cosecha"},
		    L = Table.AddColumn(Table.SelectColumns(Table.SelectRows(s, each [Larvas_Sembradas_miles] > 5000), Cols), "Motivo", each "Larvas > 5000"),
		    P = Table.AddColumn(Table.SelectColumns(Table.SelectRows(s, each [Peso_Muestreo_g] <> null and [Peso_Muestreo_g] > 60), Cols), "Motivo", each "Peso > 60 g"),
		    Juntas = Table.Combine({L, P}),
		    ConArea = Table.ExpandTableColumn(Table.NestedJoin(Juntas, {"Piscina"}, dim_Piscina, {"Piscina"}, "dim", JoinKind.LeftOuter), "dim", {"Area_ha"}),
		    Esperadas = Table.AddColumn(ConArea, "Larvas_esperadas_miles", each Number.Round([Area_ha] * [Densidad_m2] * 10, 1), type number)
		in
