expression stg_Ciclos =
		let
		  Origen = src_Ciclos,
		  #"Piscina: solo el número, formato P-00" = Table.TransformColumns(Origen, {{"Piscina", each "P-" & Text.PadStart(Text.Select(Text.From(_), {"0".."9"}), 2, "0"), type text}}),
		  #"Fechas: 4 formatos a fecha (fnTextoAFecha)" = Table.TransformColumns(#"Piscina: solo el número, formato P-00", {{"Fecha_Siembra", fnTextoAFecha, type date}, {"Fecha_Cosecha", fnTextoAFecha, type date}}),
		  #"Cosecha_Estimada: marca C-2021-013 (30/02 no existe)" =  Table.AddColumn(#"Fechas: 4 formatos a fecha (fnTextoAFecha)", "Cosecha_Estimada", each if [ID_Ciclo] = "C-2021-013" then "Sí" else "No", type text),
		  #"Fecha_Cosecha: estimada siembra + 106 días (promedio P-12)" = let
		    t = Table.AddColumn(#"Cosecha_Estimada: marca C-2021-013 (30/02 no existe)", "FC", each if [Cosecha_Estimada] = "Sí" then Date.AddDays([Fecha_Siembra], 106) else [Fecha_Cosecha], type date),
		    q = Table.RemoveColumns(t, {"Fecha_Cosecha"}),
		    r = Table.RenameColumns(q, {{"FC", "Fecha_Cosecha"}})
		  in
		    Table.ReorderColumns(r, Table.ColumnNames(#"Cosecha_Estimada: marca C-2021-013 (30/02 no existe)")),
		  #"Tipo_Cosecha: 7 formas a 3 (N = NORMAL por duración, Emerg. = EMERGENCIA)" = Table.TransformColumns(#"Fecha_Cosecha: estimada siembra + 106 días (promedio P-12)", {{"Tipo_Cosecha", each
		    let t = Text.Upper(Text.Trim(_)) in
		    if t = "N" or t = "NORMAL" then "NORMAL"
		    else if Text.StartsWith(t, "EMERG") then "EMERGENCIA"
		    else t, type text}}),
		  #"Cantidades: coma decimal a número (fnTextoANumero)" =  Table.TransformColumns(#"Tipo_Cosecha: 7 formas a 3 (N = NORMAL por duración, Emerg. = EMERGENCIA)", {
		    {"Larvas_Sembradas_miles", fnTextoANumero, type number},
		    {"Costo_Larva_USD_mil", fnTextoANumero, type number},
		    {"Densidad_m2", fnTextoANumero, type number},
		    {"Peso_Muestreo_g", fnTextoANumero, type number},
		    {"Biomasa_Cosechada", fnTextoANumero, type number},
		    {"Sobrevivencia_pct", fnTextoANumero, type number}}),
		  #"Larvas: C-2022-104 en unidades a miles (/1000)" = Table.ReplaceValue(#"Cantidades: coma decimal a número (fnTextoANumero)", each [Larvas_Sembradas_miles], each if [ID_Ciclo] = "C-2022-104" then [Larvas_Sembradas_miles] / 1000 else [Larvas_Sembradas_miles], Replacer.ReplaceValue, {"Larvas_Sembradas_miles"}),
		  #"Peso: SIG-000441 sin coma decimal (245 a 24,5)" = Table.ReplaceValue(#"Larvas: C-2022-104 en unidades a miles (/1000)", each [Peso_Muestreo_g], each if [ID_Ciclo] = "SIG-000441" then [Peso_Muestreo_g] / 10 else [Peso_Muestreo_g], Replacer.ReplaceValue, {"Peso_Muestreo_g"}),
		  #"Larvas y Peso: tipo número (ReplaceValue lo pierde)" = Table.TransformColumnTypes(#"Peso: SIG-000441 sin coma decimal (245 a 24,5)", {{"Larvas_Sembradas_miles", type number}, {"Peso_Muestreo_g", type number}}),
		  #"ID_Ciclo: tipo texto" = Table.TransformColumnTypes(#"Larvas y Peso: tipo número (ReplaceValue lo pierde)", {{"ID_Ciclo", type text}}),
		  #"Laboratorio: 10 formas a 3 por palabra clave; vacío = Desconocido" = Table.TransformColumns(#"ID_Ciclo: tipo texto", {{"Laboratorio", each
		    let t = if _ = null then "" else Text.Upper(Text.Trim(Text.From(_))) in
		    if t = "" then "Desconocido"
		    else if Text.Contains(t, "BIOGEN") then "Biogenética del Pacífico"
		    else if Text.Contains(t, "PUNTA BLANCA") then "Larvas Punta Blanca"
		    else if Text.Contains(t, "SANTA ELENA") then "Santa Elena Larvas"
		    else _, type text}}),
		  #"Filas duplicadas exactas: quitar (3 ciclos cargados dos veces)" = Table.Distinct(#"Laboratorio: 10 formas a 3 por palabra clave; vacío = Desconocido"),
		  #"Observaciones: -, s/n y ok a vacío (vacíos disfrazados)" = Table.TransformColumns(#"Filas duplicadas exactas: quitar (3 ciclos cargados dos veces)", {{"Observaciones", each
		    let t = if _ = null then "" else Text.Trim(Text.From(_)) in
		    if List.Contains({"", "-", "s/n", "ok"}, Text.Lower(t)) then null else t, type text}}),
		  #"Biomasa: SIG de kg a lb (× 2,20462)" = Table.ReplaceValue(#"Observaciones: -, s/n y ok a vacío (vacíos disfrazados)", each [Biomasa_Cosechada], each if Text.StartsWith([ID_Ciclo], "SIG-") and [Biomasa_Cosechada] <> null then [Biomasa_Cosechada] * 2.20462 else [Biomasa_Cosechada], Replacer.ReplaceValue, {"Biomasa_Cosechada"}),
		  #"Biomasa_lb: nombre con unidad y tipo número" = Table.TransformColumnTypes(Table.RenameColumns(#"Biomasa: SIG de kg a lb (× 2,20462)", {{"Biomasa_Cosechada", "Biomasa_lb"}}), {{"Biomasa_lb", type number}})
		in
		  #"Biomasa_lb: nombre con unidad y tipo número"
	lineageTag: 4e0ecb89-8c41-4be4-b268-6d3bd36844f7
	queryGroup: 02_Staging

