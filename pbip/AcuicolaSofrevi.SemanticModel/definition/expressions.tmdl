expression QA_Periodo_Formas =
		let
		    Periodos = Table.Group(src_Gastos, {"Periodo"}, {{"Filas", each Table.RowCount(_), Int64.Type}}),
		    #"Patrón" = Table.AddColumn(Periodos, "Patron", each
		        let t = Text.From([Periodo]), izq = Text.BeforeDelimiter(t, "-")
		        in if Text.Length(izq) = 4 and Value.Is(Value.FromText(izq), type number)
