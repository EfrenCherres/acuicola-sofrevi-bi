expression stg_Gastos =
		let
		  Origen = src_Gastos,
		  #"Periodo → Fecha_Mes (dos formatos)" = Table.AddColumn(Origen, "Fecha_Mes", each
		    let
		        t = Text.Lower(Text.Trim(Text.From([Periodo]))),
		        izq = Text.BeforeDelimiter(t, "-"),
		        der = Text.AfterDelimiter(t, "-")
		    in
		        if Text.Length(izq) = 4
		        then #date(Number.From(izq), Number.From(der), 1)
		        else #date(2000 + Number.From(der),
		             List.PositionOf({"ene","feb","mar","abr","may","jun","jul","ago","sep","oct","nov","dic"}, izq) + 1, 1),
		    type date),
		  #"Quitar Periodo y ordenar columnas" = Table.ReorderColumns(Table.RemoveColumns(#"Periodo → Fecha_Mes (dos formatos)", {"Periodo"}),
		    {"Fecha_Mes", "Centro_Costo", "Rubro", "Monto_USD"}),
		  #"Centro_Costo: Sector A → A" = Table.TransformColumns(#"Quitar Periodo y ordenar columnas", {{"Centro_Costo", each
		    let t = Text.Upper(Text.Trim(Text.From(_)))
		    in if Text.StartsWith(t, "SECTOR ") then Text.AfterDelimiter(t, "SECTOR ") else t, type text}}),
		  Tipos = Table.TransformColumnTypes(#"Centro_Costo: Sector A → A", {{"Rubro", type text}, {"Monto_USD", type number}}, "en-US")
		in
		  Tipos
	lineageTag: fcf8daed-0376-4089-9201-25deaebf901e
	queryGroup: 02_Staging

