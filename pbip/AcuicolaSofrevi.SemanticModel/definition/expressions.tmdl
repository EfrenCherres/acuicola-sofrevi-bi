expression QA_Inventario =
		let
		    Conteo = #table(
		        {"Hoja", "Filas_Inventario", "Filas_Cargadas", "Columnas"},
		        {
		            {"MAESTRO_PISCINAS",          34,    Table.RowCount(src_MaestroPiscinas), Table.ColumnCount(src_MaestroPiscinas)},
		            {"CICLOS_PRODUCCION",         550,   Table.RowCount(src_Ciclos),          Table.ColumnCount(src_Ciclos)},
		            {"ALIMENTACION_DIARIA",       57480, Table.RowCount(src_Alimentacion),    Table.ColumnCount(src_Alimentacion)},
		            {"KARDEX_BODEGA",             56690, Table.RowCount(src_Kardex),          Table.ColumnCount(src_Kardex)},
		            {"COMPRAS_BALANCEADO",        748,  Table.RowCount(src_Compras),         Table.ColumnCount(src_Compras)},
		            {"PARAMETROS_AGUA",           24462, Table.RowCount(src_ParametrosAgua),  Table.ColumnCount(src_ParametrosAgua)},
		            {"LIQUIDACIONES_EMPACADORAS", 3438,  Table.RowCount(src_Liquidaciones),   Table.ColumnCount(src_Liquidaciones)},
		            {"GASTOS_OPERATIVOS",         1863,  Table.RowCount(src_Gastos),          Table.ColumnCount(src_Gastos)}
		        }
		    ),
		    Diferencia = Table.AddColumn(Conteo, "Diferencia", each [Filas_Cargadas] - [Filas_Inventario], Int64.Type),
		    Cuadra = Table.AddColumn(Diferencia, "Cuadra", each if [Diferencia] = 0 then "Sí" else "No", type text)
		in
		    Cuadra
	lineageTag: 2f23bb70-2d44-4f89-9f70-d27135d150c6
	queryGroup: QA

	annotation PBI_ResultType = Table

