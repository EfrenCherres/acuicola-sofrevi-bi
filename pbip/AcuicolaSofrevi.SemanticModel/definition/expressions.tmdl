		    J = Table.ExpandTableColumn(Table.NestedJoin(K, {"ID_Ciclo"}, A, {"ID_Ciclo"}, "A", JoinKind.Inner), "A", {"Apl"}),
		    C = Table.ExpandTableColumn(Table.NestedJoin(J, {"ID_Ciclo"}, fact_Ciclos, {"ID_Ciclo"}, "C", JoinKind.Inner), "C", {"Piscina", "Fecha_Siembra"}),
		    SoloC = Table.SelectRows(C, each List.Contains(PiscinasC, [Piscina])),
		    Anio = Table.AddColumn(SoloC, "Anio", each Date.Year([Fecha_Siembra]), Int64.Type),
		    G = Table.Group(Anio, {"Anio", "Supervisor"}, {
		        {"Ciclos", each Table.RowCount(_), Int64.Type},
		        {"Kg_Despachados", each List.Sum([Desp]), type number},
		        {"Kg_Diferencia", each List.Sum([Desp]) - List.Sum([Apl]), type number},
		        {"Pct_Diferencia", each Number.Round((List.Sum([Desp]) - List.Sum([Apl])) / List.Sum([Desp]) * 100, 2), type number}}),
