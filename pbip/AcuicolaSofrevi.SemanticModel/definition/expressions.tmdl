expression stg_Liquidaciones =
		let
		  Origen = src_Liquidaciones,
		  #"Fechas: número de serie a fecha (fnTextoAFecha)" = Table.TransformColumns(Origen, {{"Fecha_Liquidacion", fnTextoAFecha, type date}, {"Fecha_Cosecha", fnTextoAFecha, type date}}),
		  #"Empacadora: 10 formas a 3 (sin espacios ni puntos + palabra clave)" = Table.TransformColumns(#"Fechas: número de serie a fecha (fnTextoAFecha)", {{"Empacadora", each
		    let t = if _ = null then "" else Text.Remove(Text.Upper(Text.From(_)), {" ", "."}) in
		    if t = "" then "Desconocido"
		    else if Text.Contains(t, "COSTADORADA") then "Empacadora Costa Dorada S.A."
		    else if Text.Contains(t, "GOLFOAZUL") then "Exportadora Golfo Azul S.A."
		    else if Text.Contains(t, "MARAUSTRAL") then "Procesadora Mar Austral C.A."
		    else _, type text}}),
		  #"Piscina: solo el número, formato P-00 (vacíos se mantienen)" = Table.TransformColumns(#"Empacadora: 10 formas a 3 (sin espacios ni puntos + palabra clave)", {{"Piscina", each
		    if _ = null or Text.Trim(Text.From(_)) = "" then null
		    else "P-" & Text.PadStart(Text.Select(Text.From(_), {"0".."9"}), 2, "0"), type text}}),
		  #"Cantidades: texto con $ a número (fnTextoANumero)" = Table.TransformColumns(#"Piscina: solo el número, formato P-00 (vacíos se mantienen)", {{"Lbs_Guia_Remision", fnTextoANumero, type number}, {"Lbs_Recibidas", fnTextoANumero, type number}, {"Precio_USD_lb", fnTextoANumero, type number}, {"Total_USD", fnTextoANumero, type number}}),
		  #"Tipos: N_Liquidacion, Clase y Talla como texto" = Table.TransformColumnTypes(#"Cantidades: texto con $ a número (fnTextoANumero)", {{"N_Liquidacion", type text}, {"Clase", type text}, {"Talla", type text}}),
		  #"Filas duplicadas exactas: quitar (6 liquidaciones cargadas dos veces)" = Table.Distinct(#"Tipos: N_Liquidacion, Clase y Talla como texto"),
		  #"Piscina: 22 liquidaciones sin piscina inferidas por fecha y libras (validado 499" = let
		    base = #"Filas duplicadas exactas: quitar (6 liquidaciones cargadas dos veces)",
		    C = Table.SelectColumns(fact_Ciclos, {"Piscina", "Fecha_Cosecha", "Biomasa_lb"}),
		    Buscar = (fecha, lbs) =>
		        let t = Table.SelectRows(C, each [Fecha_Cosecha] = fecha) in
		        if Table.IsEmpty(t) then null
		        else Table.First(Table.Sort(Table.AddColumn(t, "Dif", each Number.Abs([Biomasa_lb] - lbs)), {{"Dif", Order.Ascending}}))[Piscina],
		    ConOrigen = Table.AddColumn(base, "Piscina_Origen", each if [Piscina] = null then "Inferida por fecha de cosecha" else "Liquidación", type text),
		    Relleno = Table.ReplaceValue(ConOrigen, each [Piscina], each if [Piscina] = null then Buscar([Fecha_Cosecha], [Lbs_Guia_Remision]) else [Piscina], Replacer.ReplaceValue, {"Piscina"})
		  in
		    Table.TransformColumnTypes(Relleno, {{"Piscina", type text}})
		in
		  #"Piscina: 22 liquidaciones sin piscina inferidas por fecha y libras (validado 499"
	lineageTag: cce37c54-b6e3-405b-a88a-dd04f0800afd
	queryGroup: 02_Staging

