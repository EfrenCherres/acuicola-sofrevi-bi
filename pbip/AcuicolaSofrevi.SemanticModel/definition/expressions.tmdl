expression QA_Numeros_Ciclos =
		let
		    s = src_Ciclos,
		    Cols = {"Larvas_Sembradas_miles", "Costo_Larva_USD_mil", "Densidad_m2", "Peso_Muestreo_g", "Biomasa_Cosechada", "Sobrevivencia_pct"},
		    Fila = (c) =>
		        let
		            v = Table.Column(s, c),
		            t = List.Select(v, each _ is text)
		        in
		            {c,
		             List.Count(List.Select(v, each _ is number)),
		             List.Count(t),
		             List.Count(List.Select(v, each _ = null)),
		             List.Count(List.Select(t, each Text.Contains(_, ",") and Text.Contains(_, "."))),
		             Text.Combine(List.FirstN(List.Distinct(t), 6), "  |  ")},
		    Resultado = #table(
		        {"Columna", "Numeros", "Textos", "Vacios", "Con_punto_y_coma", "Ejemplos_texto"},
		        List.Transform(Cols, Fila))
		in
		    Resultado
	lineageTag: 395ca187-3ec3-448b-a0e7-f72497ba8ebd
	queryGroup: QA

	annotation PBI_ResultType = Table

expression QA_Rango_Numeros =
		let
		    s = stg_Ciclos,
		    Cols = {"Larvas_Sembradas_miles", "Costo_Larva_USD_mil", "Densidad_m2", "Peso_Muestreo_g", "Biomasa_Cosechada", "Sobrevivencia_pct"},
		    Filas = Table.ToRecords(s),
		    Fila = (c) =>
		        let v = List.RemoveNulls(Table.Column(s, c)) in
		        {c,
		         List.Min(v),
		         Number.Round(List.Average(v), 2),
		         List.Max(v),
		         List.Count(List.Select(Filas, each Record.Field(_, c) = null)),
		         List.Count(List.Select(Filas, each Record.Field(_, c) = null and _[Tipo_Cosecha] = "EN CURSO"))},
		    Resultado = #table(
		        {"Columna", "Minimo", "Promedio", "Maximo", "Vacios", "Vacios_EN_CURSO"},
		        List.Transform(Cols, Fila))
		in
		    Resultado
	lineageTag: f873dfc0-e354-49c0-a1b3-3173e27a93c0
	queryGroup: QA

