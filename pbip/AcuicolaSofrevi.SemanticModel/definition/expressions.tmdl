expression QA_Inventario =
		let
		    Conteo = #table(
		        {"Hoja", "Filas_Inventario", "Filas_Cargadas", "Columnas"},
		        {
		            {"MAESTRO_PISCINAS",          34,    Table.RowCount(src_MaestroPiscinas), Table.ColumnCount(src_MaestroPiscinas)},
		            {"CICLOS_PRODUCCION",         550,   Table.RowCount(src_Ciclos),          Table.ColumnCount(src_Ciclos)},
		            {"ALIMENTACION_DIARIA",       57480, Table.RowCount(src_Alimentacion),    Table.ColumnCount(src_Alimentacion)},
		            {"KARDEX_BODEGA",             56690, Table.RowCount(src_Kardex),          Table.ColumnCount(src_Kardex)},
		            {"COMPRAS_BALANCEADO",        748,  Table.RowCount(src_Compras),         Table.ColumnCount(src_Compras)},
		            {"PARAMETROS_AGUA",           24462, Table.RowCount(src_ParametrosAgua),  Table.ColumnCount(src_ParametrosAgua)},
		            {"LIQUIDACIONES_EMPACADORAS", 3438,  Table.RowCount(src_Liquidaciones),   Table.ColumnCount(src_Liquidaciones)},
		            {"GASTOS_OPERATIVOS",         1863,  Table.RowCount(src_Gastos),          Table.ColumnCount(src_Gastos)}
		        }
		    ),
		    Diferencia = Table.AddColumn(Conteo, "Diferencia", each [Filas_Cargadas] - [Filas_Inventario], Int64.Type),
		    Cuadra = Table.AddColumn(Diferencia, "Cuadra", each if [Diferencia] = 0 then "Sí" else "No", type text)
		in
		    Cuadra
	lineageTag: 2f23bb70-2d44-4f89-9f70-d27135d150c6
	queryGroup: QA

	annotation PBI_ResultType = Table

expression stg_Piscina =
		let
		  Origen = src_MaestroPiscinas,
		  #"Quitar P-12 duplicado (área 8,8 no cuadra con ciclos)" = Table.SelectRows(Origen, each not ([Codigo] = "P-12" and [Area_ha] = 8.8)),
		  #"Codigo y Sector: tipo texto" = Table.TransformColumnTypes(#"Quitar P-12 duplicado (área 8,8 no cuadra con ciclos)", {{"Codigo", type text}, {"Sector", type text}}),
		  #"Sector: quitar prefijo ""Sector """ = Table.ReplaceValue(#"Codigo y Sector: tipo texto", "Sector ", "", Replacer.ReplaceText, {"Codigo", "Sector"}),
		  #"Codigo y Sector: recortar espacios" = Table.TransformColumns(#"Sector: quitar prefijo ""Sector """, {{"Codigo", each Text.Trim(_), type nullable text}, {"Sector", each Text.Trim(_), type nullable text}}),
		  #"Codigo y Sector: mayúsculas" = Table.TransformColumns(#"Codigo y Sector: recortar espacios", {{"Codigo", each Text.Upper(_), type nullable text}, {"Sector", each Text.Upper(_), type nullable text}}),
		  #"Area_ha: coma decimal a número (independiente de la región)" = Table.TransformColumns(#"Codigo y Sector: mayúsculas", {{"Area_ha", each if _ is number then _ else Number.From(Text.Replace(Text.Trim(_), ",", "."), "en-US"), type number}}),
		  #"Aireadores y Año: número entero y Estado: tipo texto" = Table.TransformColumnTypes(#"Area_ha: coma decimal a número (independiente de la región)", {{"Aireadores_HP", Int64.Type}, {"Anio_Construccion", Int64.Type}, {"Estado", type text}})
		in
		  #"Aireadores y Año: número entero y Estado: tipo texto"
	lineageTag: 37f8fb60-d8e3-47ce-9db5-264ccf354414
	queryGroup: 02_Staging

	annotation PBI_ResultType = Table

expression QA_Piscinas_Ciclos =
		let
		    Origen = src_Ciclos,
		    Agrupado = Table.Group(Origen, {"Piscina"}, {{"Filas", each Table.RowCount(_), Int64.Type}}),
		    Ordenado = Table.Sort(Agrupado, {{"Piscina", Order.Ascending}})
		in
		    Ordenado
	lineageTag: d5d1e814-9e58-4c15-b735-46498cb8466b
