expression QA_Controles_Liquidaciones =
		let
		    s = fact_Liquidaciones,
		    Filas = Table.ToRecords(s),
		    Dif = List.Transform(Filas, each Number.Round([Total_USD] - [Lbs_Recibidas] * [Precio_USD_lb], 2)),
		    Resultado = #table({"Control", "Valor"}, {
		        {"Filas", Table.RowCount(s)},
		        {"Fecha_Liquidacion mínima", List.Min(s[Fecha_Liquidacion])},
		        {"Fecha_Liquidacion máxima", List.Max(s[Fecha_Liquidacion])},
		        {"Liquidación antes de la cosecha", List.Count(List.Select(Filas, each [Fecha_Liquidacion] < [Fecha_Cosecha]))},
		        {"Días máx. de cosecha a liquidación", List.Max(List.Transform(Filas, each Duration.Days([Fecha_Liquidacion] - [Fecha_Cosecha])))},
		        {"Precio mínimo", List.Min(s[Precio_USD_lb])},
		        {"Precio máximo", List.Max(s[Precio_USD_lb])},
		        {"Lbs_Recibidas en cero o negativas", List.Count(List.Select(s[Lbs_Recibidas], each _ <= 0))},
		        {"Total distinto de Lbs × Precio (> 1 centavo)", List.Count(List.Select(Dif, each Number.Abs(_) > 0.01))},
		        {"Diferencia mínima", List.Min(Dif)},
		        {"Diferencia máxima", List.Max(Dif)}})
		in
		    Resultado
	lineageTag: e6cc0fdd-af92-4ec0-8546-0655259bd8f1
