	column 'Dia Relativo'
		formatString: 0
		lineageTag: 4c33fd36-c79a-421a-a0bd-9bbe04276ae0
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Dia Relativo]

		annotation SummarizationSetBy = Automatic

	partition Dim_Calendario = calculated
		mode: import
		source = ```
				
				-- ======================= PARÁMETROS: solo cambia esta sección =======================
				VAR AnioInicio = 2021              -- vacío = automático; o un año fijo, ej. 2020
				                                   -- Sofrevi: fijo porque fact_Kardex tiene una columna Hora
				VAR AnioFin = 2026                 -- vacío = automático; o un año fijo, ej. 2027
				VAR AniosAtrasMax = 20             -- modo automático: máximo de años hacia atrás
				VAR AniosAdelanteMax = 5           -- modo automático: máximo de años hacia adelante
				VAR AniosExtra = 0                 -- años adicionales al final (metas, pronósticos)
				VAR FechaUltimoDato = DATE ( 2026, 10, 20 )  -- Sofrevi: último día con operación completa; vacío = hoy; o una fecha fija, ej. DATE ( 2026, 8, 31 )
				VAR CorteMesAnterior = FALSE ()    -- TRUE () = el corte es el fin del mes anterior a hoy
				VAR ZonaHoraria = -5               -- horas respecto a UTC (Ecuador = -5)
				VAR MesInicioFiscal = 1            -- 1 = enero; 7 = julio, etc.
				VAR Idioma = "es-EC"
				VAR Feriados = { DATE ( 1900, 1, 1 ) }   -- reemplaza por tus feriados, ej.:
				                                         -- { DATE ( 2026, 1, 1 ), DATE ( 2026, 5, 1 ) }
				-- =====================================================================================
				
				-- Hoy en la zona horaria indicada (el servicio de Power BI trabaja en UTC)
				VAR Ahora = UTCNOW () + ZonaHoraria / 24
				VAR Hoy = DATE ( YEAR ( Ahora ), MONTH ( Ahora ), DAY ( Ahora ) )
				
				-- Fecha de corte: la última fecha que se considera "con datos"
				VAR FechaCorte =
				    IF (
				        NOT ISBLANK ( FechaUltimoDato ),
				        FechaUltimoDato,
				        IF ( CorteMesAnterior, EOMONTH ( Hoy, -1 ), Hoy )
				    )
				
				-- Rango base: fijo si hay años escritos; si no, detectado en el modelo y acotado
				VAR MesFinFiscal = MOD ( MesInicioFiscal - 2, 12 ) + 1
				VAR MinBase =
				    IF (
				        NOT ISBLANK ( AnioInicio ),
				        DATE ( AnioInicio, 1, 1 ),
				        MAX (
				            MINX ( CALENDARAUTO ( MesFinFiscal ), [Date] ),
				            DATE ( YEAR ( FechaCorte ) - AniosAtrasMax, 1, 1 )
				        )
				    )
				VAR MaxBase =
				    IF (
				        NOT ISBLANK ( AnioFin ),
				        DATE ( AnioFin, 12, 31 ),
				        MIN (
				            MAXX ( CALENDARAUTO ( MesFinFiscal ), [Date] ),
				            DATE ( YEAR ( FechaCorte ) + AniosAdelanteMax, 12, 31 )
				        )
				    )
				
				-- Ajuste a años fiscales completos (con MesInicioFiscal = 1 son años calendario)
				VAR Desplazar = IF ( MesInicioFiscal > 1, 1, 0 )
				VAR AnioFiscalIni =
				    YEAR ( MinBase ) + IF ( MesInicioFiscal > 1 && MONTH ( MinBase ) >= MesInicioFiscal, 1, 0 )
				VAR AnioFiscalFin =
				    YEAR ( MaxBase ) + IF ( MesInicioFiscal > 1 && MONTH ( MaxBase ) >= MesInicioFiscal, 1, 0 )
				VAR FechaInicio = DATE ( AnioFiscalIni - Desplazar, MesInicioFiscal, 1 )
				VAR FechaFin = DATE ( AnioFiscalFin - Desplazar + 1 + AniosExtra, MesInicioFiscal, 1 ) - 1
				
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( FechaInicio, FechaFin ),
				
				    -- ---------- Año, mes y día ----------
				    "Año", YEAR ( [Date] ),
				    "Mes Num", MONTH ( [Date] ),
				    "Mes",
				        VAR X = FORMAT ( [Date], "mmmm", Idioma )
				        RETURN UPPER ( LEFT ( X, 1 ) ) & MID ( X, 2, LEN ( X ) ),
				    "Mes Corto",
				        VAR X = FORMAT ( [Date], "mmmm", Idioma )
				        RETURN UPPER ( LEFT ( X, 1 ) ) & MID ( X, 2, 2 ),
				    "Año Mes",
				        VAR X = FORMAT ( [Date], "mmmm", Idioma )
				        RETURN UPPER ( LEFT ( X, 1 ) ) & MID ( X, 2, 2 ) & " " & YEAR ( [Date] ),
				    "Año Mes Num", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "Periodo", FORMAT ( [Date], "yyyy-mm" ),
				    "Inicio Mes", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
				    "Fin Mes", EOMONTH ( [Date], 0 ),
				    "Dia Mes", DAY ( [Date] ),
				    "Dia Año", INT ( [Date] - DATE ( YEAR ( [Date] ), 1, 1 ) ) + 1,
				
				    -- ---------- Agrupaciones del año ----------
				    "Trimestre", "T" & QUARTER ( [Date] ),
				    "Trimestre Orden", QUARTER ( [Date] ),
				    "Año Trimestre", YEAR ( [Date] ) & "-T" & QUARTER ( [Date] ),
				    "Año Trimestre Num", YEAR ( [Date] ) * 10 + QUARTER ( [Date] ),
				    "Semestre", "Sem " & IF ( MONTH ( [Date] ) <= 6, 1, 2 ),
				    "Semestre Orden", IF ( MONTH ( [Date] ) <= 6, 1, 2 ),
				    "Bimestre", "Bim " & ROUNDUP ( MONTH ( [Date] ) / 2, 0 ),
				    "Bimestre Orden", ROUNDUP ( MONTH ( [Date] ) / 2, 0 ),
				    "Cuatrimestre", "Cuatrim " & ROUNDUP ( MONTH ( [Date] ) / 4, 0 ),
				    "Cuatrimestre Orden", ROUNDUP ( MONTH ( [Date] ) / 4, 0 ),
				
				    -- ---------- Semanas (ISO 8601: lunes a domingo; la semana 1 contiene el primer jueves) ----------
				    "Semana ISO", WEEKNUM ( [Date], 21 ),
				    "Año ISO", YEAR ( [Date] - WEEKDAY ( [Date], 3 ) + 3 ),
				    "Año Semana",
				        YEAR ( [Date] - WEEKDAY ( [Date], 3 ) + 3 ) & "-S" & FORMAT ( WEEKNUM ( [Date], 21 ), "00" ),
				    "Año Semana Num",
				        YEAR ( [Date] - WEEKDAY ( [Date], 3 ) + 3 ) * 100 + WEEKNUM ( [Date], 21 ),
				    "Inicio Semana", [Date] - WEEKDAY ( [Date], 2 ) + 1,
				
				    -- ---------- Días ----------
				    "Dia Semana", WEEKDAY ( [Date], 2 ),
				    "Nombre Dia",
				        VAR D = FORMAT ( [Date], "dddd", Idioma )
				        RETURN UPPER ( LEFT ( D, 1 ) ) & MID ( D, 2, LEN ( D ) ),
				    "Nombre Dia Corto",
				        VAR D = FORMAT ( [Date], "dddd", Idioma )
				        RETURN UPPER ( LEFT ( D, 1 ) ) & MID ( D, 2, 2 ),
				    "Es Fin de Semana", IF ( WEEKDAY ( [Date], 2 ) >= 6, "Sí", "No" ),
				    "Es Feriado", IF ( [Date] IN Feriados, "Sí", "No" ),
				    "Es Laborable",
				        IF ( WEEKDAY ( [Date], 2 ) <= 5 && NOT ( [Date] IN Feriados ), "Sí", "No" ),
				
				    -- ---------- Año fiscal (se nombra por el año en que termina) ----------
				    "Año Fiscal",
				        YEAR ( [Date] ) + IF ( MesInicioFiscal > 1 && MONTH ( [Date] ) >= MesInicioFiscal, 1, 0 ),
				    "Mes Fiscal", MOD ( MONTH ( [Date] ) - MesInicioFiscal, 12 ) + 1,
				    "Trimestre Fiscal",
				        "TF" & ROUNDUP ( ( MOD ( MONTH ( [Date] ) - MesInicioFiscal, 12 ) + 1 ) / 3, 0 ),
				
				    -- ---------- Columnas relativas a la fecha de corte ----------
				    "Con Datos", [Date] <= FechaCorte,
				    "Hasta Fecha Comparable",
				        MONTH ( [Date] ) * 100 + DAY ( [Date] )
				            <= MONTH ( FechaCorte ) * 100 + DAY ( FechaCorte ),
				    "Mes Relativo",
				        ( YEAR ( [Date] ) - YEAR ( FechaCorte ) ) * 12 + MONTH ( [Date] ) - MONTH ( FechaCorte ),
				    "Año Relativo", YEAR ( [Date] ) - YEAR ( FechaCorte ),
				    "Dia Relativo", INT ( [Date] - FechaCorte )
				)
				
				
				```

	annotation PBI_Id = 3ad936fc2bd8471c964d9e34f0c0eac2

