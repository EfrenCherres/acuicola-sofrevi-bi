		sourceColumn: ID_Ciclo

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition fact_Kardex = m
		mode: import
		queryGroup: 03_Final
		source =
				let
				  Origen = stg_Kardex,
				  Personalizado = Origen,
				  #"Proveedor: desde el código del producto" = Table.AddColumn(Origen, "Proveedor", each
				    let p = Text.BeforeDelimiter([Codigo_Producto], "-") in
				    if p = "NA" then "NUTRIACUA S.A."
				    else if p = "AFL" then "AQUAFEED LITORAL S.A."
				    else if p = "BA" then "BALANCEADOS ANDINOS CIA. LTDA."
				    else "Desconocido", type text),
				  #"Kg_Por_Saco: último número del código" = Table.AddColumn(#"Proveedor: desde el código del producto", "Kg_Por_Saco", each
				    Number.From(Text.AfterDelimiter([Codigo_Producto], "-", {0, RelativePosition.FromEnd})), Int64.Type),
				  #"Kg_Despachados: sacos × kg por saco" = Table.AddColumn(#"Kg_Por_Saco: último número del código", "Kg_Despachados", each [Sacos] * [Kg_Por_Saco], type number),
				  #"ID_Ciclo: ciclo activo en la piscina ese día" = let
				    base = #"Kg_Despachados: sacos × kg por saco",
				    C = Table.Buffer(Table.SelectColumns(fact_Ciclos, {"ID_Ciclo", "Piscina", "Fecha_Siembra", "Fecha_Cosecha"})),
				    PorPiscina = Record.FromTable(Table.Group(Table.RenameColumns(C, {{"Piscina", "Name"}}), {"Name"}, {{"Value", each Table.Buffer(_)}})),
				    Buscar = (p, f) =>
				        let t = Record.FieldOrDefault(PorPiscina, p, null),
				            m = if t = null then #table({}, {}) else Table.SelectRows(t, (r) => r[Fecha_Siembra] <= f and (r[Fecha_Cosecha] = null or f <= r[Fecha_Cosecha]))
				        in if Table.IsEmpty(m) then null else m{0}[ID_Ciclo]
				  in
				    Table.AddColumn(base, "ID_Ciclo", each Buscar([Piscina], [Fecha]), type text)
				in
				  #"ID_Ciclo: ciclo activo en la piscina ese día"

	annotation PBI_ResultType = Table

