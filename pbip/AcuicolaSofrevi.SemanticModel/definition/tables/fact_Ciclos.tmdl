	partition fact_Ciclos = m
		mode: import
		queryGroup: 03_Final
		source =
				let
				  Origen = stg_Ciclos,
				  #"Sistema: C (anterior, hasta mar-2023) o SIG (desde mar-2023)" = Table.AddColumn(Origen, "Sistema", each Text.BeforeDelimiter([ID_Ciclo], "-"), type text),
				  #"Dias_Cultivo: cosecha menos siembra (vacío si EN CURSO)" = Table.AddColumn(#"Sistema: C (anterior, hasta mar-2023) o SIG (desde mar-2023)", "Dias_Cultivo", each if [Fecha_Cosecha] = null then null else Duration.Days([Fecha_Cosecha] - [Fecha_Siembra]), Int64.Type)
				in
				  #"Dias_Cultivo: cosecha menos siembra (vacío si EN CURSO)"

	annotation PBI_ResultType = Table

