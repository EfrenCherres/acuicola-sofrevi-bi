	column Registrado_Por
		dataType: string
		lineageTag: ff48e8d1-9d6f-4c16-81e8-a8446f492e86
		summarizeBy: none
		sourceColumn: Registrado_Por

		annotation SummarizationSetBy = Automatic

	column ID_Ciclo
		dataType: string
		lineageTag: a93ec35c-e924-4bc7-9d89-7413ade99b06
		summarizeBy: none
		sourceColumn: ID_Ciclo

		annotation SummarizationSetBy = Automatic

	partition fact_Alimentacion = m
		mode: import
		queryGroup: 03_Final
		source =
				let
				  Origen = stg_Alimentacion,
				  #"ID_Ciclo: ciclo activo en la piscina ese día" = let
				    base = Origen,
				    C = Table.Buffer(Table.SelectColumns(fact_Ciclos, {"ID_Ciclo", "Piscina", "Fecha_Siembra", "Fecha_Cosecha"})),
				    PorPiscina = Record.FromTable(Table.Group(Table.RenameColumns(C, {{"Piscina", "Name"}}), {"Name"}, {{"Value", each Table.Buffer(_)}})),
				    Buscar = (p, f) =>
				        let t = Record.FieldOrDefault(PorPiscina, p, null),
				            m = if t = null then #table({}, {}) else Table.SelectRows(t, (r) => r[Fecha_Siembra] <= f and (r[Fecha_Cosecha] = null or f <= r[Fecha_Cosecha]))
				        in if Table.IsEmpty(m) then null else m{0}[ID_Ciclo]
				  in
				    Table.AddColumn(base, "ID_Ciclo", each Buscar([Piscina], [Fecha]), type text)
				in
				  #"ID_Ciclo: ciclo activo en la piscina ese día"

	annotation PBI_ResultType = Table

