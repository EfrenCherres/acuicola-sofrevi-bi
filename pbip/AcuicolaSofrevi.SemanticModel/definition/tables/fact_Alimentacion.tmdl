table fact_Alimentacion
	lineageTag: b1ed9779-d436-4441-b945-ca2c4e053f8e

	column Fecha
		dataType: dateTime
		formatString: Long Date
		lineageTag: 4a055df2-b600-4f2d-bb20-b5f6ed50d50b
		summarizeBy: none
		sourceColumn: Fecha

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Piscina
		dataType: string
		lineageTag: 2a49bde0-3ed9-4940-8cf9-b0deb55052af
		summarizeBy: none
		sourceColumn: Piscina

		annotation SummarizationSetBy = Automatic

	column Kg_Aplicados
		dataType: double
		lineageTag: dd5a3071-ee6c-4562-afc4-41d24b94402a
		summarizeBy: sum
		sourceColumn: Kg_Aplicados

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Proveedor
		dataType: string
		lineageTag: 8ffce26a-9f56-43b6-976c-d0f98f2532b3
		summarizeBy: none
		sourceColumn: Proveedor

