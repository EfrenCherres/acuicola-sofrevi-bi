	partition fact_Liquidaciones = m
		mode: import
		queryGroup: 03_Final
		source =
				let
				  Origen = stg_Liquidaciones,
				  #"Orden_Talla: primer número de la talla (S/T al final)" = Table.AddColumn(Origen, "Orden_Talla", each if [Talla] = "S/T" then 999 else Number.From(Text.BeforeDelimiter([Talla], "/")), Int64.Type),
				  #"ID_Ciclo: ciclo de la cosecha (piscina + fecha de cosecha)" = let
				    J = Table.NestedJoin(#"Orden_Talla: primer número de la talla (S/T al final)", {"Piscina", "Fecha_Cosecha"}, Table.SelectColumns(fact_Ciclos, {"ID_Ciclo", "Piscina", "Fecha_Cosecha"}), {"Piscina", "Fecha_Cosecha"}, "Ciclo", JoinKind.LeftOuter)
				  in
				    Table.ExpandTableColumn(J, "Ciclo", {"ID_Ciclo"})
				in
				  #"ID_Ciclo: ciclo de la cosecha (piscina + fecha de cosecha)"

	annotation PBI_ResultType = Table

