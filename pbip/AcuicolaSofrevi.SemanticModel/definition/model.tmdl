model Model
	culture: es-EC
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-419
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 00_Parametros

	annotation PBI_QueryGroupOrder = 0

queryGroup 01_Origen

	annotation PBI_QueryGroupOrder = 1

queryGroup 02_Staging

	annotation PBI_QueryGroupOrder = 2

queryGroup 03_Final

	annotation PBI_QueryGroupOrder = 3

queryGroup QA

	annotation PBI_QueryGroupOrder = 4

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["RutaArchivo","src_SofreviBD","src_MaestroPiscinas","src_Ciclos","src_Alimentacion","src_Kardex","src_Compras","src_ParametrosAgua","src_Liquidaciones","src_Gastos","QA_Piscinas_Ciclos","QA_Inventario","stg_Piscina","dim_Piscina","stg_Ciclos","stg_Compras","QA_Piscinas_Ciclos_Despues","QA_Piscinas_Huerfanas","QA_Fechas_Ciclos","QA_Fechas_DiaMes","QA_Fechas_Errores","QA_Duracion_Ciclos","QA_Rango_Fechas","fnTextoAFecha","QA_TipoCosecha","QA_TipoCosecha_Duracion","QA_Numeros_Ciclos","QA_Rango_Numeros","QA_Atipicos_Ciclos","QA_Larvas_vs_Area","fnTextoANumero","QA_Laboratorio","QA_IDs_Duplicados","QA_Observaciones","QA_Obs_vs_Tipo","QA_Biomasa_Unidad","QA_Sistemas","QA_Biomasa_C","fact_Ciclos","dim_Laboratorio","QA_Laboratorio_Huerfanos","QA_Proveedor","QA_Numeros_Compras","QA_Calculos_Compras","QA_Facturas_Repetidas"]

